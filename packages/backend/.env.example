# Application
APP_PORT=8000
APP_LOG=vitro_be=debug,tower_http=debug,axum::rejection=debug,tower_http::trace::make_span=debug,sqlx=debug

# PostgreSQL
PG_DATABASE_HOST=localhost
PG_DATABASE_PORT=5432
PG_DATABASE_DB=apidb
PG_DATABASE_SCHEMA=app
PG_DATABASE_USERNAME=postgres
PG_DATABASE_PASSWORD=postgres

# Authentication
JWT_SECRET=replace-with-a-development-secret
JWT_EXPIRE_DURATION=3600
