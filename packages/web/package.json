		"@tailwindcss/vite": "4.1.18",
		"jsdom": "^26.0.0",
		"openapi-typescript": "^7.13.0",
		"tailwindcss": "4.1.18",
		"typescript": "5.9.3",
		"vite": "7.3.1",
		"vite-plugin-solid": "^2.11.16",
		"vitest": "^3.2.4"
