{
	"name": "vitro",
	"private": true,
	"packageManager": "bun@1.3.13",
	"workspaces": ["packages/*"],
	"scripts": {
		"dev": "turbo run dev",
		"dev:client": "turbo run dev --filter=@vitro/frontend",
		"dev:server": "turbo run dev --filter=@vitro/backend",
		"setup": "turbo run setup",
		"db:up": "turbo run db:up --filter=@vitro/backend",
		"db:down": "turbo run db:down --filter=@vitro/backend",
		"db:migrate": "turbo run db:migrate --filter=@vitro/backend",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"format:check": "turbo run format:check",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"test:client": "turbo run test --filter=@vitro/frontend",
		"test:server": "turbo run test --filter=@vitro/backend",
		"test:e2e": "turbo run test:e2e --filter=@vitro/backend",
		"check": "turbo run lint format:check typecheck test"
	},
	"devDependencies": {
		"turbo": "^2.10.12"
	}
}
